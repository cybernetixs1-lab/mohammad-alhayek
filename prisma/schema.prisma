generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WaitlistEntry {
  id           Int      @id @default(autoincrement())
  ticketNumber Int      @unique
  name         String
  partySize    Int
  joinedAt     DateTime @default(now())

  @@index([joinedAt])
}

model TicketCounter {
  id               Int @id @default(autoincrement())
  nextTicketNumber Int
}
